# Copy to .env for local development. On Render, set these in the dashboard instead.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database: use ONE of these options (SQLite is used if neither is set)
# Option 1 - a single URL (Render PostgreSQL "Internal Database URL")
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Option 2 - separate values (Docker Compose)
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=secretpassword
# DB_HOST=db
# DB_PORT=5432
